# Copy this file to ".env" and fill in your values. NEVER commit the real .env file.

# Which LLM backend to use: anthropic | openai | ollama | none
#   anthropic -> Claude via the Anthropic Messages API (needs an API key)
#   openai    -> OpenAI Chat Completions API (needs an API key)
#   ollama    -> a locally running model served by Ollama (no key needed)
#   none      -> retrieval-only mode: returns the best-matching FAQ answer, no LLM
LLM_PROVIDER=anthropic

# API key for the chosen provider (not needed for ollama / none)
LLM_API_KEY=your-api-key-here

# Optional overrides (sensible defaults are used when these are empty)
# LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=400
# LLM_TIMEOUT=30

# Optional chatbot tuning
# FAQ_PATH=data/faqs.json
# TOP_K=3
# MIN_SCORE=0.25
# MAX_HISTORY_MESSAGES=8
# MAX_INPUT_CHARS=500
